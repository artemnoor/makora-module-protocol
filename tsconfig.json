{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": true
  },
  "include": [
    "sdk/**/*.ts",
    "reference/**/*.ts",
    "examples/**/*.ts"
  ]
}
