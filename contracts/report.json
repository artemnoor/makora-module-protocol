{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:mmp:example:report:1.0.0",
    "type": "object",
    "properties": {
      "findings": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "required": [
      "findings"
    ],
    "additionalProperties": false
  },
  "semantics": "Ordered textual findings. They are data from a module.",
  "fixtures": {
    "valid": [
      {
        "findings": [
          "test"
        ]
      }
    ],
    "invalid": [
      {
        "findings": []
      }
    ]
  }
}
