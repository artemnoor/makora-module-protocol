{
  "id": "org.example.ledger",
  "publisher": "org.example",
  "version": "1.0.0",
  "mmpVersion": "0.1.0",
  "description": "Example MMP ledger module.",
  "requires": [],
  "operations": [
    {
      "capability": "org.example/record",
      "inputContract": "urn:mmp:example:task:1.0.0",
      "outputContract": "urn:mmp:example:receipt:1.0.0",
      "tool": "record",
      "permissions": [
        "ledger.write"
      ],
      "effects": "write",
      "execution": "sync",
      "idempotency": {
        "mode": "deduplicated",
        "retentionSeconds": 1,
        "restartPersistent": false
      }
    }
  ]
}
